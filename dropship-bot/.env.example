# ===== PDD 开放平台（用于拉新订单 + 回传物流）=====
# 申请地址：https://open.pinduoduo.com/  → 开发者中心 → 创建应用拿到下面两项
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=

# ===== 通知（任选其一，填完整 webhook URL）=====
#  Server 酱：https://sct.ftqq.com/  → 拿到 https://sctapi.ftqq.com/SCTxxxx.send
#  企业微信/钉钉：机器人 webhook
NOTIFY_URL=

# ===== 1688 登录态（Playwright 持久化目录）=====
# 首次需手动用该目录登录一次 1688（同账号），之后机器人复用登录态建采购单
P1688_PROFILE_DIR=./.p1688

# ===== 轮询间隔（秒）=====
POLL_INTERVAL=60

# ===== 物流回填安全开关 =====
# false（默认）：抓到 1688 物流号后只通知你，不自动回传 PDD（最安全，人工确认再发）
# true：抓到物流号后自动回传 PDD 完成发货（省一步，但需确保 PDD 凭证与物流号正确）
AUTO_SHIP=false
