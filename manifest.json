{
  "manifest_version": 3,
  "name": "电商订单信息助手",
  "version": "2.5.4",
  "description": "通用浏览器插件：在拼多多/淘宝/京东/抖音等电商商家后台抓取订单与开票信息（订单号/物品/订单状态/快递公司/快递单号/发票抬头/税号/金额），支持自动翻页全量采集，本地汇总去重，一键导出 Excel。无需开放平台资质，装上即用。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://mms.pinduoduo.com/*",
    "https://*.pinduoduo.com/*",
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.jd.com/*",
    "https://*.douyin.com/*",
    "https://*.jinritemai.com/*",
    "https://fxg.jinritemai.com/*",
    "https://*.feihong.cc/*",
    "https://*.kuaishou.com/*",
    "https://*.1688.com/*"
  ],
  "action": {
    "default_title": "电商订单信息助手",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
