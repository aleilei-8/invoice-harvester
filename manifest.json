{
  "manifest_version": 3,
  "name": "电商订单信息助手",
  "version": "3.3.5",
  "description": "电商开票助手：1688「导出当前条件」与拼多多订单导出自动捕获解析入库（分区管理，1688 不做自动导出避免重复下载），按快递单号+快递公司匹配，生成按卖家分组开票清单与开票跟踪表，支持开票状态回填。本地处理，不上传服务器。",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": [
    "https://mms.pinduoduo.com/*",
    "https://*.pinduoduo.com/*",
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.jd.com/*",
    "https://*.douyin.com/*",
    "https://*.jinritemai.com/*",
    "https://fxg.jinritemai.com/*",
    "https://*.feihong.cc/*",
    "https://*.kuaishou.com/*",
    "https://*.1688.com/*",
    "https://*.alicdn.com/*"
  ],
  "web_accessible_resources": [
    { "resources": ["xlsx.full.min.js"], "matches": ["<all_urls>"] }
  ],
  "action": {
    "default_title": "电商订单信息助手",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.1688.com/*"],
      "js": ["pagefuncs.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
